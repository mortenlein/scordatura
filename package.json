{
  "name": "scordatura",
  "version": "1.0.0",
  "description": "An Electron app to scrape and format Ultimate Guitar tabs side-by-side.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mortenlein/scordatura.git"
  },
  "build": {
    "appId": "com.mortenlein.scordatura",
    "productName": "Scordatura",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    }
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "googleapis": "^122.0.0",
    "google-auth-library": "^9.0.0",
    "open": "^8.4.2",
    "dotenv": "^16.4.5"
  }
}
